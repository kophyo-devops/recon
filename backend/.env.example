DATABASE_URL=postgresql+psycopg://ceir_app:ceir_app_secret@localhost:5432/ceir_db
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_DOCS=true
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
# Optional bcrypt hash (overrides AUTH_PASSWORD when set):
# AUTH_PASSWORD_HASH=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Use false on local http://localhost; true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
