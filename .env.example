# Copy to .env and adjust as needed for docker compose.
# Local defaults are already baked into docker-compose.yml.

POSTGRES_USER=ceir
POSTGRES_PASSWORD=ceir_secret
POSTGRES_DB=ceir_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://ceir_app:ceir_app_secret@postgres:5432/ceir_db
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend
API_PORT=8000
WEB_PORT=3000
ENABLE_DOCS=true

JWT_SECRET=ceir-dev-jwt-secret-change-in-production-32b
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend → backend (Docker network hostname)
BACKEND_ORIGIN=http://backend:8000
NEXT_PUBLIC_API_URL=
